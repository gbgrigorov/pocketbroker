# Frontend build-time configuration (Vite). Copy to .env.local as needed.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Google Analytics 4 measurement id.
#   - Production builds already default to the live property (see consentStore.js),
#     so you do NOT need to set this to ship analytics.
#   - Local dev has GA OFF by default (no pollution from local work). Set this in
#     a .env.local to test GA against your own/staging property locally.
#   - When set, this value overrides the built-in default.
# GA only ever loads after the visitor accepts the consent banner.
VITE_GA_ID=G-XXXXXXXXXX
